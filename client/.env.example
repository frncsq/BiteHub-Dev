# API: leave unset for local dev — Vite proxies /api to http://127.0.0.1:5000 (no CORS issues).
# For production, set the full API origin, e.g.:
# VITE_API_URL=https://your-api.example.com

# Google AdSense — copy to .env and replace with your AdSense account values
VITE_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
VITE_ADSENSE_SLOT_HOMEPAGE_TOP=0000000000
VITE_ADSENSE_SLOT_HOMEPAGE_SIDEBAR=0000000001
VITE_ADSENSE_SLOT_MENU_BETWEEN=0000000002
VITE_ADSENSE_SLOT_FOOTER=0000000003
VITE_ADSENSE_SLOT_SPONSORED_CARD=0000000004
VITE_ADSENSE_SLOT_DASHBOARD_PROMO=0000000005
VITE_ADSENSE_SLOT_RESTAURANT_FEATURED=0000000006
