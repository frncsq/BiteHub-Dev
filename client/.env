# API: omit in local dev so requests stay on the Vite origin and proxy to the API (fixes CORS).
# Set for production builds, e.g. VITE_API_URL=https://your-api.example.com
# VITE_API_URL=http://localhost:5000

# Google AdSense — replace with your values from https://adsense.google.com
# Publisher ID (Ad client): Account → Account information → Publisher ID
VITE_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX

# Ad unit slot IDs — Ads → By ad unit → select unit → copy Slot ID
VITE_ADSENSE_SLOT_HOMEPAGE_TOP=0000000000
VITE_ADSENSE_SLOT_HOMEPAGE_SIDEBAR=0000000001
VITE_ADSENSE_SLOT_MENU_BETWEEN=0000000002
VITE_ADSENSE_SLOT_FOOTER=0000000003
VITE_ADSENSE_SLOT_SPONSORED_CARD=0000000004
VITE_ADSENSE_SLOT_DASHBOARD_PROMO=0000000005
VITE_ADSENSE_SLOT_RESTAURANT_FEATURED=0000000006
